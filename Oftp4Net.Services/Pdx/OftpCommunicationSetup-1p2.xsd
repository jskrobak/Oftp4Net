			</element>
			<element name="FileEncryption" type="ocs:SupportInfoType" minOccurs="1" maxOccurs="1">
				<annotation>
					<documentation>Information if file encryption is supported and/or required</documentation>
				</annotation>
			</element>
			<element name="FileCompression" type="ocs:SupportInfoTypeNoCertificate" minOccurs="1" maxOccurs="1">

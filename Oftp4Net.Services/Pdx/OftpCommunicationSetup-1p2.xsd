	<simpleType name="dateTimeTZ">
		<restriction base="dateTime">
			<pattern value="\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d(.\d\d\d|)(Z|[+\-]\d\d:\d\d){1}"/>
		</restriction>
	</simpleType>
	<simpleType name="CertificateDataType">
		<restriction base="base64Binary"/>
	</simpleType>
	<simpleType name="CertificateRefType">
		<annotation>
			<documentation>Reference to a certificate using its @ name</documentation>
		</annotation>
		<restriction base="string"/>
	</simpleType>
	<complexType name="CertificatesType">
		<annotation>
			<documentation>Certificates being used for session setup or file transfer</documentation>
		</annotation>
		<sequence>
			<element name="Certificate" type="ocs:CertificateType" minOccurs="1" maxOccurs="unbounded"/>
		</sequence>
	</complexType>
	<complexType name="CertificateType">
		<annotation>
			<documentation>Certificate data of one particular certificate including its chain of CA-certificates</documentation>
		</annotation>
		<sequence>
			<element name="SubjectName" type="string" minOccurs="1" maxOccurs="1">
				<annotation>
					<documentation>The subject DN of the certificate</documentation>
				</annotation>
			</element>
			<element name="X509Certificate" type="ocs:CertificateDataType" minOccurs="1" maxOccurs="1">
				<annotation>
					<documentation>The main certificate</documentation>
				</annotation>
			</element>
			<element name="X509CACertificate" type="ocs:CertificateDataType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Additional CA certificates that are part of the chain</documentation>
				</annotation>
			</element>
		</sequence>
		<attribute name="name" type="string" use="required">
			<annotation>
				<documentation>The name identifying this particular certificate to be used within this document where certificate-informations are provided</documentation>
			</annotation>
		</attribute>
	</complexType>
	<complexType name="CipherSettingType">
		<annotation>
			<documentation>Information about the cipher(s) to be used for session establishment and file transfer.</documentation>
		</annotation>
		<sequence>
			<element name="PrimaryCipher" type="ocs:CipherValueType" minOccurs="1" maxOccurs="1">
				<annotation>
					<documentation>The cipher, the stations prefers to be used</documentation>
				</annotation>
			</element>
			<element name="AlternateCipher" type="ocs:CipherValueType" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Ciphers the station will accept as well, if the primary cipher isn't supported by the peer</documentation>
				</annotation>
			</element>
		</sequence>
	</complexType>
	<simpleType name="CipherValueType">
		<annotation>
			<documentation>
Valid values (at the time of the creation of this XSD:

 - 01 (3DES, RSA, SHA-1)
 - 02 (AES-256, RSA, SHA-1)
 - 03 (3DES, RSA, SHA-256)
 - 04 (AES-256, RSA, SHA-256)
 - 05 (3DES, RSA, SHA-512)
 - 06 (AES-256, RSA, SHA-512)
 - 07 (AES-256, RSA, SHA3-512)
      </documentation>
		</annotation>
		<restriction base="string">
			<enumeration value="01">
				<annotation>
					<documentation source="Name">3DES, RSA, SHA-1</documentation>
				</annotation>
			</enumeration>
			<enumeration value="02">
				<annotation>
					<documentation source="Name">AES-256, RSA, SHA-1</documentation>
				</annotation>
			</enumeration>
			<enumeration value="03">
				<annotation>
					<documentation source="Name">3DES, RSA, SHA-256</documentation>
				</annotation>
			</enumeration>
			<enumeration value="04">
				<annotation>
					<documentation source="Name">AES-256, RSA, SHA-256</documentation>
				</annotation>
			</enumeration>
			<enumeration value="05">
				<annotation>
					<documentation source="Name">3DES, RSA, SHA-512</documentation>
				</annotation>
			</enumeration>
			<enumeration value="06">
				<annotation>
					<documentation source="Name">AES-256, RSA, SHA-512</documentation>
				</annotation>
			</enumeration>
			<enumeration value="07">
				<annotation>
					<documentation source="Name">AES-256, RSA, SHA3-512</documentation>
				</annotation>
			</enumeration>
		</restriction>
	</simpleType>
	<complexType name="CompanyInfoType">
		<annotation>
			<documentation>Information about the company that owns the station</documentation>
		</annotation>
		<sequence>
			<element name="Name" type="string" minOccurs="1" maxOccurs="1">
				<annotation>
					<documentation>Name of the company</documentation>
				</annotation>
			</element>
			<element name="AddressLine" type="string" minOccurs="0" maxOccurs="unbounded">
				<annotation>
					<documentation>Street / location etc.</documentation>
				</annotation>
			</element>
			<element name="City" type="string" minOccurs="0" maxOccurs="1"/>
			<element name="ZIPCode" type="string" minOccurs="0" maxOccurs="1">
				<annotation>
					<documentation>Post code</documentation>
				</annotation>
			</element>
			<element name="Country" type="ocs:CountryCodeType" minOccurs="0" maxOccurs="1">
				<annotation>
					<documentation>Country coded according ISO 3166-1  alpha-2 code </documentation>
				</annotation>
			</element>
		</sequence>
	</complexType>
	<complexType name="ConnectionSettingType">
		<sequence>
			<element name="TLSVersion" type="ocs:TLSVersionType" minOccurs="0" maxOccurs="4">
				<annotation>
					<documentation>The exact TLS version required for a connection. If omitted, TLS negotiation is allowed.</documentation>
				</annotation>
			</element>
		</sequence>
		<attribute name="type" default="TLS">
			<annotation>
				<documentation>
TLS - port 6619 - default setting for public internet
TCP - port 3305 (e.g. used over VPN connections such as ENX)

        </documentation>
			</annotation>
			<simpleType>
				<restriction base="string">
					<enumeration value="TCP"/>
					<enumeration value="TLS"/>
				</restriction>
			</simpleType>
		</attribute>
	</complexType>
	<complexType name="ContactsType">

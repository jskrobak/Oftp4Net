	<complexType name="ContactType">
		<annotation>
			<documentation>Contact information. At least a phone-number or an email-address must be provided</documentation>
		</annotation>
		<sequence>
			<element name="Name" minOccurs="1" maxOccurs="1">
				<annotation>
					<documentation>Short name identifying the type of contact</documentation>

	<complexType name="InboundCommunicationSettingsType">
		<annotation>
			<documentation>Network settings for inbound communication (connections to the station described in this document)</documentation>
		</annotation>
		<sequence>
			<element name="InboundConnectionSettings" type="ocs:InboundConnectionSettingType" minOccurs="1" maxOccurs="unbounded"/>
		</sequence>
	</complexType>
	<complexType name="InboundConnectionSettingType">
		<annotation>
			<documentation>Network connection settings for a particular connection-type</documentation>
		</annotation>
		<complexContent>
			<extension base="ocs:ConnectionSettingType">
				<sequence>
					<element name="ServerHost" type="string" minOccurs="1" maxOccurs="1">
						<annotation>
							<documentation>The server hostname or IP-address to connect to</documentation>
						</annotation>
					</element>
					<element name="ServerPort" minOccurs="1" maxOccurs="1">
						<annotation>
							<documentation>The port to connect to</documentation>
						</annotation>
						<simpleType>
							<restriction base="int">
								<maxInclusive value="65535"/>
								<minInclusive value="1"/>
							</restriction>
						</simpleType>
					</element>
					<element name="CertificateRef" type="ocs:CertificateRefType" minOccurs="0" maxOccurs="1">
						<annotation>
							<documentation>(where applicable) The certificate being used as server certificate when being connected using TLS</documentation>
						</annotation>
					</element>
					<element name="TLSClientAuth" type="ocs:SupportInfoTypeNoCertificate" minOccurs="0" maxOccurs="1">
						<annotation>
							<documentation>(where applicable) The information if the server supports and/or requires TLS client authentication</documentation>
						</annotation>
					</element>
				</sequence>
			</extension>
		</complexContent>
	</complexType>

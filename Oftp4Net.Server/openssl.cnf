# OpenSSL configuration of the Docker image (OPENSSL_CONF).
#
# Ubuntu forbids TLS 1.0 and 1.1 and certificates signed with SHA-1 even when an application asks for them. Some
# OFTP partners know nothing newer (HUB-Master of NUMLOG: TLS 1.0 only, CA signed with SHA-1), so the floor is
# lowered here. Oftp4Net always names the TLS versions of a connection itself, TLS 1.2 and 1.3 unless a partner or a
# listener is set to an obsolete one, so the other connections stay as they were.
openssl_conf = openssl_init

[openssl_init]
ssl_conf = ssl_sect

[ssl_sect]
system_default = system_default_sect

[system_default_sect]
MinProtocol = TLSv1
CipherString = DEFAULT:@SECLEVEL=0

@page "/ChangePassword"
@layout Layout.EmptyLayout
@attribute [ExcludeFromInteractiveRouting]
@using Oftp4Net.Services

<PageTitle>Oftp4Net | Change password</PageTitle>

<div class="card shadow-sm" style="width: 24rem;">
    <div class="card-body">
        <h4 class="card-title mb-3">Change password</h4>

        @if (MustChange)
        {
            <div class="alert alert-warning py-2">You are using an initial password. Set a new one to continue.</div>
        }
        @if (!string.IsNullOrEmpty(Error))
        {
            <div class="alert alert-danger py-2">@Error</div>
        }

        <form method="post" action="account/change-password" data-enhance="false">
            <AntiforgeryToken />
            <div class="mb-3">
                <label for="currentPassword" class="form-label">Current password</label>
                <input id="currentPassword" name="currentPassword" type="password" class="form-control" autocomplete="current-password" required autofocus />
            </div>
            <div class="mb-3">
                <label for="newPassword" class="form-label">New password</label>
                <input id="newPassword" name="newPassword" type="password" class="form-control" autocomplete="new-password"
                       minlength="@UserService.MinPasswordLength" required />
                <div class="form-text">At least @UserService.MinPasswordLength characters.</div>
            </div>
            <div class="mb-3">
                <label for="confirmPassword" class="form-label">Confirm new password</label>
                <input id="confirmPassword" name="confirmPassword" type="password" class="form-control" autocomplete="new-password" required />
            </div>
            <button type="submit" class="btn btn-primary w-100">Change password</button>
        </form>

        @if (!MustChange)
        {
            <div class="text-center mt-3"><a href="/">Back</a></div>
        }
    </div>
</div>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = null!;
    [SupplyParameterFromQuery] private string? Error { get; set; }

    private bool MustChange => HttpContext.User.HasClaim(c => c.Type == AuthClaims.MustChangePassword);
}

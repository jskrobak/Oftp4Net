@page "/Partners"
@rendermode InteractiveServer
@using System.Security.Authentication
@using Oftp4Net.Core
@using Oftp4Net.DataLayer.Filters
@using Oftp4Net.Domain
@using Oftp4Net.Services.Encodings
@using Oftp4Net.Services.Security
@using Oftp4Net.Services.Import
<style>
    .scrollable-table-container {
        overflow: auto;
        height: calc(100vh - 160px);
    }
</style>
<HxModal @ref="partnerEditModal" ShowCloseButton="true">
    <HeaderTemplate>
        Edit Oftp Partner
    </HeaderTemplate>
    <BodyTemplate>
            @if (currentPartner is not null)
            {
                <EditForm Model="@currentPartner" OnValidSubmit="@(async() => { await SavePartner(); })">
                    <DataAnnotationsValidator />

                    <HxInputText Label="Name" @bind-Value="@currentPartner.Name" />
                    <HxInputText Label="Description" @bind-Value="@currentPartner.Description" />
                    <HxInputText Label="SSID" @bind-Value="@currentPartner.SSID" />
                    <HxInputText Label="SFID" @bind-Value="@currentPartner.SFID" />
                    <HxInputText Label="Password" Hint="Password the partner sends in its SSID. Leave empty to not check it." Type="InputType.Password" @bind-Value="@currentPartner.Password" />
                    <HxInputText Label="Host" @bind-Value="@currentPartner.Host" />
                    <HxInputNumber Decimals="0" Type="InputType.Number" Label="Port" @bind-Value="@currentPartner.Port" />

                    <HxCheckbox Label="Use TLS" @bind-Value="@currentPartner.UseTls"></HxCheckbox>
                
                    <HxSelect TItem="Certificate"
                              TValue="int?"
                              Label="Trusted certificate"
                              Hint="Partner's server certificate or its CA. Leave empty to use the system trust store."
                              Data="availableCertificates"
                              @bind-Value="@currentPartner.TrustedCertificateId"
                              TextSelector="@(c => $"{c.Name} (valid to {c.ValidTo:d})")"
                              ValueSelector="@(c => c.Id)"
                              Nullable="true"
                              NullText="-system trust store-" />

                    <HxMultiSelect Label="Tls"
                                   TItem="SslProtocols"
                                   TValue="int"
                                   Data="OftpDefaults.AllowedSslProtocols"
                                   @bind-Value="SelectedTlsVersions"
                                   TextSelector="@(p => p.ToString())"
                                   ValueSelector="@(p => (int)p)"
                                   NullDataText="Loading .."
                                   EmptyText="-select SSL versions-" />


                    <HxCheckbox Label="Enable buffer compression"
                                Hint="Runs of equal octets are compressed in the data exchange buffers when the partner offers it too."
                                @bind-Value="@currentPartner.BufferCompression" />

                    <HxCheckbox Label="Enable restart of interrupted transfers"
                                Hint="An interrupted file continues at the last complete 1K block instead of being sent again. Not used for signed, compressed or encrypted files."
                                @bind-Value="@currentPartner.Restart" />

                    <HxSelect TItem="FileCharacterEncoding"
                              TValue="FileCharacterEncoding"
                              Label="Encoding of outgoing files"
                              Hint="Content of files sent to the partner is converted to this encoding."
                              Data="Enum.GetValues<FileCharacterEncoding>()"
                              @bind-Value="@currentPartner.OutgoingEncoding"
                              TextSelector="@(e => e.ToString())"
                              ValueSelector="@(e => e)"
                              Nullable="false" />

                    <HxCheckbox Label="Convert incoming EBCDIC to ANSI"
                                Hint="Content of files received from the partner is converted from EBCDIC to ANSI."
                                @bind-Value="@currentPartner.ConvertIncomingEbcdicToAnsi" />

                    @if (ConversionConfigured)
                    {
                        <HxSelect TItem="CodePageInfo"
                                  TValue="int"
                                  Label="ANSI code page"
                                  Hint="Encoding files are stored in on this server."
                                  Data="CharacterEncodings.AnsiCodePages"
                                  @bind-Value="@currentPartner.AnsiCodePage"
                                  TextSelector="@(c => c.Name)"
                                  ValueSelector="@(c => c.CodePage)"
                                  SortKeySelector="@(c => c.CodePage)"
                                  Nullable="false" />

                        <HxSelect TItem="CodePageInfo"
                                  TValue="int"
                                  Label="EBCDIC code page"
                                  Hint="EBCDIC variant used by the partner."
                                  Data="CharacterEncodings.EbcdicCodePages"
                                  @bind-Value="@currentPartner.EbcdicCodePage"
                                  TextSelector="@(c => c.Name)"
                                  ValueSelector="@(c => c.CodePage)"
                                  SortKeySelector="@(c => c.CodePage)"
                                  Nullable="false" />
                    }

                    <hr />
                    <h6>Security</h6>

                    <HxCheckbox Label="Enable file compression"
                                Hint="Content of sent files is compressed with zlib in a CMS package."
                                @bind-Value="@currentPartner.CompressFiles" />

                    <HxCheckbox Label="Enable file signing"
                                Hint="Content of sent files is signed with the file security certificate from the settings."
                                @bind-Value="@currentPartner.SignFiles" />

                    <HxCheckbox Label="Enable file encryption"
                                Hint="Content of sent files is encrypted for the partner's certificate."
                                @bind-Value="@currentPartner.EncryptFiles" />

                    <HxCheckbox Label="Enable secure authentication"
                                Hint="After the SSID exchange both sides prove they hold the private key of the certificate the other one knows. The partner has to require it too."
                                @bind-Value="@currentPartner.SecureAuthentication" />

                    <HxCheckbox Label="Ask partner for a signed EERP or NERP"
                                Hint="The partner is asked to sign the End to End Response of our files."
                                @bind-Value="@currentPartner.RequestSignedEndResponse" />

                    @if (FileSecurityConfigured)
                    {
                        <HxSelect TItem="CipherSuite"
                                  TValue="string"
                                  Label="Cipher suite"
                                  Hint="Used for signatures, encryption and hashes. Suites 01 and 02 are supported by every OFTP2 node."
                                  Data="CipherSuite.All"
                                  @bind-Value="@currentPartner.FileCipherSuite"
                                  TextSelector="@(s => $"{s.Code} - {s.Name}")"
                                  ValueSelector="@(s => s.Code)"
                                  Nullable="false" />

                        <HxSelect TItem="Certificate"
                                  TValue="int?"
                                  Label="Partner certificate"
                                  Hint="The partner's certificate: files and authentication challenges are encrypted for it and the partner's signatures are verified against it."
                                  Data="availableCertificates"
                                  @bind-Value="@currentPartner.SecurityCertificateId"
                                  TextSelector="@(c => $"{c.Name} (valid to {c.ValidTo:d})")"
                                  ValueSelector="@(c => c.Id)"
                                  Nullable="true"
                                  NullText="-none-" />
                    }

                    <HxSubmit Color="ThemeColor.Primary">Save</HxSubmit>

                </EditForm>
            }
    </BodyTemplate>
</HxModal>

<HxModal @ref="importModal" ShowCloseButton="true" Size="ModalSize.Large">
    <HeaderTemplate>
        Import partners from OS4X
    </HeaderTemplate>
    <BodyTemplate>
        <EditForm Model="@importOptions" OnValidSubmit="LoadOs4xPartners">
            <DataAnnotationsValidator />

            <div class="row g-2">
                <div class="col-md-4"><HxInputText Label="Host" @bind-Value="@importOptions.Host" /></div>
                <div class="col-md-2"><HxInputNumber Label="Port" Decimals="0" @bind-Value="@importOptions.Port" /></div>
                <div class="col-md-3"><HxInputText Label="Database" @bind-Value="@importOptions.Database" /></div>
                <div class="col-md-3"><HxInputText Label="Table prefix" @bind-Value="@importOptions.TablePrefix" /></div>
                <div class="col-md-4"><HxInputText Label="User" @bind-Value="@importOptions.User" /></div>
                <div class="col-md-4">
                    <HxInputText Label="Password" Type="InputType.Password" @bind-Value="@importOptions.Password"
                                 Hint="Used for this import only, it is not stored." />
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <HxSubmit Color="ThemeColor.Secondary" Icon="BootstrapIcon.Search" Spinner="importLoading">Load partners</HxSubmit>
                </div>
            </div>
        </EditForm>

        @if (importCandidates is not null)
        {
            <hr />
            @if (importCandidates.Count == 0)
            {
                <p class="mb-0">The partner table of the installation is empty.</p>
            }
            else
            {
                <table class="table table-sm align-middle">
                    <thead>
                    <tr>
                        <th style="width: 2rem;"></th>
                        <th>Name</th>
                        <th>SSID</th>
                        <th>Address</th>
                        <th>Security</th>
                        <th>Identity</th>
                        <th>State</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var candidate in importCandidates)
                    {
                        <tr class="@(candidate.CanImport ? "" : "text-body-secondary")">
                            <td>
                                <HxCheckbox @bind-Value="candidate.Selected" Enabled="candidate.CanImport" />
                            </td>
                            <td>@candidate.Name</td>
                            <td>@candidate.Ssid</td>
                            <td>@candidate.Address</td>
                            <td>@candidate.Security</td>
                            <td>@(string.IsNullOrEmpty(candidate.IdentitySsid) ? "-" : candidate.IdentitySsid)</td>
                            <td>
                                @candidate.Status
                                @foreach (var note in candidate.Notes)
                                {
                                    <div class="small text-body-secondary">@note</div>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>

                <HxButton Color="ThemeColor.Primary" Icon="BootstrapIcon.Download" Spinner="importRunning"
                          OnClick="ImportOs4xPartners">
                    Import selected (@importCandidates.Count(c => c.Selected))
                </HxButton>
            }
        }
    </BodyTemplate>
</HxModal>

<HxListLayout Title="Partners" TFilterModel="PartnerFilter"
              @bind-FilterModel="filterModel"
              @bind-FilterModel:after="gridComponent.RefreshDataAsync">
    <CommandsTemplate>
        <HxButton Text="New partner"
                  Color="ThemeColor.Primary"
                  Icon="BootstrapIcon.PlusLg" OnClick="HandleNewItemClicked" />
        <HxButton Text="Import from OS4X"
                  Color="ThemeColor.Secondary"
                  Icon="BootstrapIcon.BoxArrowInDown" OnClick="HandleImportClicked" />
        <HxDropdownButtonGroup>
            <HxDropdownToggleButton CssClass="contextDropdownToggleButton" Color="ThemeColor.Secondary" Icon="BootstrapIcon.ThreeDots">
            </HxDropdownToggleButton>
            <HxDropdownMenu>
                <HxDropdownItem Icon="BootstrapIcon.Trash" OnClick="HandleDeleteSelected">Delete selected</HxDropdownItem>
            </HxDropdownMenu>
        </HxDropdownButtonGroup>
    </CommandsTemplate>
    <FilterTemplate Context="filterContext">
        <HxInputText Label="Name" @bind-Value="filterContext.Name" />
    </FilterTemplate>
    <DataTemplate>
        <HxGrid @ref="gridComponent"
                ContentNavigationMode="GridContentNavigationMode.Pagination"
                PageSize="1000"
                MultiSelectionEnabled="true"
                @bind-SelectedDataItems="selectedItems"
                TableContainerCssClass="scrollable-table-container"
                HeaderRowCssClass="sticky-top"
                FooterRowCssClass="sticky-bottom"
                TItem="Partner"
                DataProvider="GetGridData"
                @bind-SelectedDataItem="currentPartner"
                @bind-SelectedDataItem:after="HandleSelectedDataItemChanged"
                Responsive="true"
                PreserveSelection="false">
            <Columns>
                
                <HxGridColumn HeaderText="Name"
                              ItemTextSelector="@(d => d.Name)"
                              SortKeySelector="d => d.Name"
                              IsDefaultSortColumn="true"/>
                <HxGridColumn HeaderText="Description"
                              ItemTextSelector="@(d => d.Description)"
                              SortKeySelector="d => d.Description"/>
                <HxGridColumn HeaderText="SSID"
                              ItemTextSelector="@(d => d.SSID)"
                              SortKeySelector="d => d.SSID"/>
                <HxGridColumn HeaderText="SFID"
                              ItemTextSelector="@(d => d.SFID)"
                              SortKeySelector="d => d.SFID"/>
                <HxGridColumn HeaderText="Host"
                              ItemTextSelector="@(d => d.Host)"
                              SortKeySelector="d => d.Host"/>
                @* Not sortable: an enum sort key cannot be translated to SQL. *@
                <HxGridColumn HeaderText="Encoding"
                              ItemTextSelector="@(d => EncodingDescription(d))"/>
                <HxGridColumn HeaderText="Security"
                              ItemTextSelector="@(d => SecurityDescription(d))"/>
                
                <HxContextMenuGridColumn Context="currentPartner">
                    <HxContextMenu>
                        <HxContextMenuItem Text="Edit"
                                           Icon="BootstrapIcon.Pen"
                                           OnClick="async () => await HandleEditClick(currentPartner)" />

                        <HxContextMenuItem Text="Delete"
                                           Icon="BootstrapIcon.Trash"
                                           OnClick="async () => await HandleDeleteClick(currentPartner)"
                                           ConfirmationQuestion="@($"Are you sure you really want to delete selected partners? ({currentPartner.Id})")"/>

                    </HxContextMenu>
                </HxContextMenuGridColumn>
            </Columns>
        </HxGrid>
    </DataTemplate>
 
</HxListLayout>
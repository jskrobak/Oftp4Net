@page "/Partners"
@rendermode InteractiveServer
@using System.Security.Authentication
@using Oftp4Net.Core
@using Oftp4Net.DataLayer.Filters
@using Oftp4Net.Domain
@using Oftp4Net.Services.Encodings
@using Oftp4Net.Services.Security
@using Oftp4Net.Services.Import
@using Oftp4Net.Core.Protocol
@using Oftp4Net.Services.Pdx
@using Oftp4Net.Services.Oftp
<style>
    .scrollable-table-container {
        overflow: auto;
        height: calc(100vh - 160px);
    }

    .sub-station-row td {
        font-size: 0.875em;
    }
</style>
<HxModal @ref="partnerEditModal" ShowCloseButton="true">
    <HeaderTemplate>
        Edit Oftp Partner
    </HeaderTemplate>
    <BodyTemplate>
            @if (currentPartner is not null)
            {
                <PartnerForm Partner="currentPartner" Certificates="availableCertificates" Identities="availableIdentities"
                             OpenSetups="openSetups" OnSaved="HandlePartnerSaved" />
            }
    </BodyTemplate>
</HxModal>

<HxModal @ref="subStationModal" ShowCloseButton="true">
    <HeaderTemplate>
        @(subStationOriginalSfid is null ? "New sub-station" : "Edit sub-station")
    </HeaderTemplate>
    <BodyTemplate>
        @if (subStationPartner is not null && editedSubStation is not null)
        {
            <EditForm Model="@editedSubStation" OnValidSubmit="@(async () => { await SaveSubStation(); })">
                <div class="form-text mb-3">
                    Reached through the connection of the partner <strong>@subStationPartner.Name</strong> (@subStationPartner.SSID):
                    host, codes, passwords, TLS and secure authentication are the partner's. Files go to the SFID of the sub-station.
                </div>

                <HxInputText Label="Name" @bind-Value="@editedSubStation.Name" />
                <HxInputText Label="SFID"
                             Hint="SFIDDEST of the files we send to the sub-station, SFIDORIG of the files it sends."
                             MaxLength="SubStationEditor.MaxSfidLength"
                             @bind-Value="@editedSubStation.SFID" />

                <hr />
                <h6>Security</h6>
                <div class="form-text mb-2">What is not set here is taken over from the partner.</div>

                <InheritedSetting Label="Enable file compression" Inherited="subStationPartner.CompressFiles"
                                  @bind-Value="@editedSubStation.CompressFiles" />
                <InheritedSetting Label="Enable file signing" Inherited="subStationPartner.SignFiles"
                                  @bind-Value="@editedSubStation.SignFiles" />
                <InheritedSetting Label="Enable file encryption" Inherited="subStationPartner.EncryptFiles"
                                  @bind-Value="@editedSubStation.EncryptFiles" />
                <InheritedSetting Label="Ask for a signed EERP or NERP" Inherited="subStationPartner.RequestSignedEndResponse"
                                  @bind-Value="@editedSubStation.RequestSignedEndResponse" />
                <InheritedSetting Label="Require signed files" Inherited="subStationPartner.RequireSignedFiles"
                                  @bind-Value="@editedSubStation.RequireSignedFiles" />
                <InheritedSetting Label="Require encrypted files" Inherited="subStationPartner.RequireEncryptedFiles"
                                  @bind-Value="@editedSubStation.RequireEncryptedFiles" />
                <InheritedSetting Label="Require compressed files" Inherited="subStationPartner.RequireCompressedFiles"
                                  @bind-Value="@editedSubStation.RequireCompressedFiles" />

                <HxSelect TItem="CipherSuite"
                          TValue="string"
                          Label="Cipher suite"
                          Data="CipherSuite.Supported"
                          @bind-Value="@editedSubStation.FileCipherSuite"
                          TextSelector="@(s => $"{s.Code} - {s.Name}")"
                          ValueSelector="@(s => s.Code)"
                          Nullable="true"
                          NullText="@($"as the partner ({subStationPartner.FileCipherSuite})")" />

                <div class="form-text mb-3">Certificates of the sub-station are assigned in the dialog of the partner (<em>Certificates of the partner per purpose</em>).</div>

                @if (editedSubStation.InboundDsnPatterns.Count > 0 || editedSubStation.OutboundDsnPatterns.Count > 0)
                {
                    <hr />
                    <h6>From the OFTP2 Communication Setup</h6>
                    <dl class="row small mb-2 text-break">
                        @foreach (var dsn in editedSubStation.InboundDsnPatterns.Select(d => ("receives", d))
                                      .Concat(editedSubStation.OutboundDsnPatterns.Select(d => ("sends", d))))
                        {
                            <dt class="col-sm-4">Sub-station @dsn.Item1</dt>
                            <dd class="col-sm-8"><code>@dsn.Item2.Pattern</code> (@dsn.Item2.FileFormat) @dsn.Item2.Description</dd>
                        }
                    </dl>
                }

                <hr />
                <h6>Contacts</h6>
                <div class="form-text mb-2">E-mails and phones separated by commas. Replaced by the contacts of the partner's datasheet when one is imported.</div>
                <PartnerContactsEditor Contacts="editedSubStation.Contacts" />

                @if (subStationError is not null)
                {
                    <HxAlert Color="ThemeColor.Danger" CssClass="py-2 mt-3 small">@subStationError</HxAlert>
                }

                <HxSubmit Color="ThemeColor.Primary" CssClass="mt-3">Save</HxSubmit>
            </EditForm>
        }
    </BodyTemplate>
</HxModal>

<HxModal @ref="importModal" ShowCloseButton="true" Size="ModalSize.Large">
    <HeaderTemplate>
        Import partners from OS4X
    </HeaderTemplate>
    <BodyTemplate>
        <EditForm Model="@importOptions" OnValidSubmit="LoadOs4xPartners">
            <DataAnnotationsValidator />

            <div class="row g-2">
                <div class="col-md-4"><HxInputText Label="Host" @bind-Value="@importOptions.Host" /></div>
                <div class="col-md-2"><HxInputNumber Label="Port" Decimals="0" @bind-Value="@importOptions.Port" /></div>
                <div class="col-md-3"><HxInputText Label="Database" @bind-Value="@importOptions.Database" /></div>
                <div class="col-md-3"><HxInputText Label="Table prefix" @bind-Value="@importOptions.TablePrefix" /></div>
                <div class="col-md-4"><HxInputText Label="User" @bind-Value="@importOptions.User" /></div>
                <div class="col-md-4">
                    <HxInputText Label="Password" Type="InputType.Password" @bind-Value="@importOptions.Password"
                                 Hint="Used for this import only, it is not stored." />
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <HxSubmit Color="ThemeColor.Secondary" Icon="BootstrapIcon.Search" Spinner="importLoading">Load partners</HxSubmit>
                </div>
            </div>
        </EditForm>

        @if (importCandidates is not null)
        {
            <hr />
            @if (importCandidates.Count == 0)
            {
                <p class="mb-0">The partner table of the installation is empty.</p>
            }
            else
            {
                <table class="table table-sm align-middle">
                    <thead>
                    <tr>
                        <th style="width: 2rem;"></th>
                        <th>OS4X name</th>
                        <th>Imported as</th>
                        <th>SSID</th>
                        <th>Address</th>
                        <th>Security</th>
                        <th>Our identity</th>
                        <th>State</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var candidate in importCandidates)
                    {
                        <tr class="@(candidate.CanImport ? "" : "text-body-secondary")">
                            <td>
                                <HxCheckbox @bind-Value="candidate.Selected" Enabled="candidate.CanImport" />
                            </td>
                            <td>@candidate.Name</td>
                            <td>@candidate.Target</td>
                            <td>@candidate.Ssid</td>
                            <td>@candidate.Address</td>
                            <td>@candidate.Security</td>
                            <td>@candidate.Identity</td>
                            <td>
                                @candidate.Status
                                @foreach (var note in candidate.Notes)
                                {
                                    <div class="small text-body-secondary">@note</div>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>

                @if (importCertificates.Count > 0)
                {
                    <h6 class="mt-3">Trusted certificates</h6>
                    <p class="small text-body-secondary">
                        Certificates OS4X trusts for the TLS connections of all partners, added there by hand. They are
                        imported as trusted for TLS of all partners; the Odette trust list is read by Oftp4Net itself.
                    </p>
                    <table class="table table-sm align-middle">
                        <thead>
                        <tr>
                            <th style="width: 2rem;"></th>
                            <th>Name</th>
                            <th>Subject</th>
                            <th>Valid to</th>
                            <th>State</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var certificate in importCertificates)
                        {
                            <tr class="@(certificate.CanImport ? "" : "text-body-secondary")">
                                <td>
                                    <HxCheckbox @bind-Value="certificate.Selected" Enabled="certificate.CanImport" />
                                </td>
                                <td>@certificate.Name</td>
                                <td class="small">@certificate.Subject</td>
                                <td>@certificate.ValidTo.ToString("d")</td>
                                <td>
                                    @certificate.Status
                                    @foreach (var note in certificate.Notes)
                                    {
                                        <div class="small text-body-secondary">@note</div>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }

                <HxButton Color="ThemeColor.Primary" Icon="BootstrapIcon.Download" Spinner="importRunning"
                          OnClick="ImportOs4xPartners">
                    Import selected (@importCandidates.Count(c => c.Selected) partner rows, @importCertificates.Count(c => c.Selected) certificates)
                </HxButton>
            }
        }
    </BodyTemplate>
</HxModal>

<HxModal @ref="datasheetModal" ShowCloseButton="true" Size="ModalSize.Large">
    <HeaderTemplate>
        Send our OFTP2 Communication Setup (PDX)
    </HeaderTemplate>
    <BodyTemplate>
        @if (datasheetPartner is not null && datasheetIdentities is not null)
        {
            <OwnDatasheet Identities="datasheetIdentities" Partner="datasheetPartner" OnSent="() => datasheetModal.HideAsync()" />
        }
    </BodyTemplate>
</HxModal>

<HxModal @ref="certificateModal" ShowCloseButton="true" Size="ModalSize.Large">
    <HeaderTemplate>
        Send one of our certificates
    </HeaderTemplate>
    <BodyTemplate>
        @if (certificatePartner is not null && certificateIdentities is not null)
        {
            <CertificateExchangeForm Partner="certificatePartner" Identities="certificateIdentities"
                                     Certificates="ownCertificates" CertificateId="ownCertificateId"
                                     OnSent="() => certificateModal.HideAsync()" />
        }
    </BodyTemplate>
</HxModal>

<HxModal @ref="testFileModal" ShowCloseButton="true" Size="ModalSize.Large">
    <HeaderTemplate>Send a test file to @testFilePartner?.Name</HeaderTemplate>
    <BodyTemplate>
        @if (testFilePartner is not null && testFileIdentities is not null)
        {
            <TestFileForm Partner="testFilePartner" Station="testFileStation" Identities="testFileIdentities" />
        }
    </BodyTemplate>
</HxModal>

<HxModal @ref="connectionTestModal" ShowCloseButton="true" Size="ModalSize.Large">
    <HeaderTemplate>
        Test the connection to @connectionTestPartner?.Name
    </HeaderTemplate>
    <BodyTemplate>
        @if (connectionTestPartner is not null && connectionTestIdentities is not null)
        {
            <ConnectionTestForm Partner="connectionTestPartner" Identities="connectionTestIdentities" />
        }
    </BodyTemplate>
</HxModal>

<HxModal @ref="pdxModal" ShowCloseButton="true" Size="ModalSize.Large">
    <HeaderTemplate>
        Import OFTP2 Communication Setup (PDX)
    </HeaderTemplate>
    <BodyTemplate>
        <p class="small text-body-secondary">
            The datasheet of a partner (XML, Odette OFTP2 Communication Setup). A partner with the same SSID is updated,
            otherwise a new partner is created. The settings are compared with the station profile in the settings.
        </p>
        <InputFile class="form-control" accept=".xml,text/xml,application/xml" OnChange="HandlePdxFileSelected" />

        @if (pdxLoading)
        {
            <div class="mt-3"><HxSpinner Size="SpinnerSize.Small" /> Reading the datasheet…</div>
        }
        else if (pdxPlan is not null)
        {
            <hr />
            @if (pdxPlan.Document is { } document)
            {
                <p class="mb-2">
                    <strong>@pdxPlan.PartnerName</strong> (@document.Session.Ssid):
                    @(pdxPlan.IsNew ? "a new partner is created" : "the existing partner is updated").
                    <span class="small text-body-secondary">Datasheet @document.DocId, created @document.DocDate.LocalDateTime.ToString("g"), valid from @document.ValidFrom.LocalDateTime.ToString("g").</span>
                </p>
            }

            @foreach (var error in pdxPlan.Errors)
            {
                <HxAlert Color="ThemeColor.Danger" CssClass="py-2 mb-2">@error</HxAlert>
            }
            @foreach (var warning in pdxPlan.Warnings)
            {
                <HxAlert Color="ThemeColor.Warning" CssClass="py-2 mb-2">@warning</HxAlert>
            }

            @if (pdxPlan.Changes.Count > 0)
            {
                <table class="table table-sm align-middle small">
                    <thead>
                    <tr>
                        <th>Setting</th>
                        @if (!pdxPlan.IsNew)
                        {
                            <th>Current</th>
                        }
                        <th>@(pdxPlan.IsNew ? "Value" : "New")</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var change in pdxPlan.Changes)
                    {
                        <tr>
                            <td>@change.Field</td>
                            @if (!pdxPlan.IsNew)
                            {
                                <td class="text-body-secondary">@(change.OldValue ?? "-")</td>
                            }
                            <td>@(change.NewValue ?? "-")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
            else if (pdxPlan.CanApply)
            {
                <p>The datasheet changes nothing.</p>
            }

            @if (pdxPlan.CanApply && pdxPlan.Changes.Count > 0)
            {
                @if (PdxCanBeScheduled)
                {
                    <HxCheckbox Text="@($"Apply at its valid from time ({pdxPlan.Document!.ValidFrom.LocalDateTime:g}), not now")"
                                @bind-Value="pdxSchedule" CssClass="mb-2" />
                }
                <HxButton Color="ThemeColor.Primary" Icon="BootstrapIcon.Check2" Spinner="pdxApplying" OnClick="ApplyPdx">
                    @(pdxPlan.IsNew ? "Create partner" : pdxSchedule && PdxCanBeScheduled ? "Schedule update" : "Update partner")
                </HxButton>
            }
        }
    </BodyTemplate>
</HxModal>

@if (openSetups.Count(d => d.Status == PartnerSetupStatus.PendingApproval) is > 0 and var pending)
{
    <HxAlert Color="ThemeColor.Warning" CssClass="py-2">
        @pending datasheet(s) of partners wait for approval: <a href="PartnerSetups">Partner setups</a>.
    </HxAlert>
}

<HxListLayout Title="Partners" TFilterModel="PartnerFilter"
              @bind-FilterModel="filterModel"
              @bind-FilterModel:after="gridComponent.RefreshDataAsync">
    <CommandsTemplate>
        <HxButton Text="New partner"
                  Color="ThemeColor.Primary"
                  Icon="BootstrapIcon.PlusLg" OnClick="HandleNewItemClicked" />
        <HxButton Text="Import PDX"
                  Color="ThemeColor.Secondary"
                  Icon="BootstrapIcon.FiletypeXml" OnClick="HandlePdxImportClicked" />
        <HxButton Text="Import from OS4X"
                  Color="ThemeColor.Secondary"
                  Icon="BootstrapIcon.BoxArrowInDown" OnClick="HandleImportClicked" />
        <a class="btn btn-secondary" href="ConnectionTests"><HxIcon Icon="BootstrapIcon.Plug" /> Connection tests</a>
        <HxDropdownButtonGroup>
            <HxDropdownToggleButton CssClass="contextDropdownToggleButton" Color="ThemeColor.Secondary" Icon="BootstrapIcon.ThreeDots">
            </HxDropdownToggleButton>
            <HxDropdownMenu>
                <HxDropdownItem Icon="BootstrapIcon.Trash" OnClick="HandleDeleteSelected">Delete selected</HxDropdownItem>
            </HxDropdownMenu>
        </HxDropdownButtonGroup>
    </CommandsTemplate>
    <FilterTemplate Context="filterContext">
        <HxInputText Label="Name" @bind-Value="filterContext.Name" />
    </FilterTemplate>
    <DataTemplate>
        <HxGrid @ref="gridComponent"
                ContentNavigationMode="GridContentNavigationMode.Pagination"
                PageSize="1000"
                MultiSelectionEnabled="true"
                @bind-SelectedDataItems="selectedItems"
                TableContainerCssClass="scrollable-table-container"
                HeaderRowCssClass="sticky-top"
                FooterRowCssClass="sticky-bottom"
                TItem="PartnerRow"
                DataProvider="GetGridData"
                ItemRowCssClassSelector="@(r => r.SubStation is null ? null : "sub-station-row")"
                @bind-SelectedDataItem="selectedRow"
                @bind-SelectedDataItem:after="HandleSelectedDataItemChanged"
                Responsive="true"
                PreserveSelection="false">
            <Columns>
                @* Sub-stations are listed under their partner: every column sorts by the partner. *@
                <HxGridColumn HeaderText="Name"
                              SortKeySelector="r => r.Partner.Name"
                              IsDefaultSortColumn="true">
                    <ItemTemplate Context="row">
                        @if (row.SubStation is { } sub)
                        {
                            <span class="ps-3 text-body-secondary"><HxIcon Icon="BootstrapIcon.ArrowReturnRight" /></span>
                            @sub.Name
                        }
                        else
                        {
                            @row.Partner.Name
                        }
                    </ItemTemplate>
                </HxGridColumn>
                <HxGridColumn HeaderText="Description"
                              ItemTextSelector="@(r => r.SubStation is null ? r.Partner.Description : "sub-station")"
                              SortKeySelector="r => r.Partner.Description"/>
                <HxGridColumn HeaderText="SSID"
                              ItemTextSelector="@(r => r.SubStation is null ? r.Partner.SSID : "")"
                              SortKeySelector="r => r.Partner.SSID"/>
                <HxGridColumn HeaderText="SFID"
                              ItemTextSelector="@(r => r.SubStation?.SFID ?? r.Partner.SFID)"
                              SortKeySelector="r => r.Partner.SFID"/>
                <HxGridColumn HeaderText="Host"
                              ItemTextSelector="@(r => r.SubStation is null ? r.Partner.Host : "")"
                              SortKeySelector="r => r.Partner.Host"/>
                <HxGridColumn HeaderText="Release"
                              ItemTextSelector="@(r => r.SubStation is null ? ProtocolLevels.Name(r.Partner.ProtocolLevel) : "")"
                              SortKeySelector="r => r.Partner.ProtocolLevel"/>
                <HxGridColumn HeaderText="Encoding"
                              ItemTextSelector="@(r => r.SubStation is null ? EncodingDescription(r.Partner) : "")"/>
                <HxGridColumn HeaderText="Security"
                              ItemTextSelector="@(r => r.SubStation is { } sub ? SubStationText(sub) : SecurityDescription(r.Partner))"/>

                <HxContextMenuGridColumn Context="row">
                    <HxContextMenu>
                        @if (row.SubStation is { } sub)
                        {
                            <HxContextMenuItem Text="Edit"
                                               Icon="BootstrapIcon.Pen"
                                               OnClick="async () => await HandleEditSubStationClick(row.Partner, sub)" />

                            <HxContextMenuItem Text="Send test file"
                                               Icon="BootstrapIcon.Send"
                                               OnClick="async () => await HandleSendTestFileClick(row.Partner, sub)" />

                            <HxContextMenuItem Text="Delete"
                                               Icon="BootstrapIcon.Trash"
                                               OnClick="async () => await HandleDeleteSubStationClick(row.Partner, sub)"
                                               ConfirmationQuestion="@($"Delete the sub-station {sub.Name} ({sub.SFID}) of {row.Partner.Name}?")"/>
                        }
                        else
                        {
                            <HxContextMenuItem Text="Edit"
                                               Icon="BootstrapIcon.Pen"
                                               OnClick="async () => await HandleEditClick(row.Partner)" />

                            <HxContextMenuItem Text="Add sub-station"
                                               Icon="BootstrapIcon.Diagram3"
                                               OnClick="async () => await HandleAddSubStationClick(row.Partner)" />

                            <HxContextMenuItem Text="Send our datasheet"
                                               Icon="BootstrapIcon.FiletypeXml"
                                               OnClick="async () => await HandleSendDatasheetClick(row.Partner)" />

                            <HxContextMenuItem Text="Send our certificate"
                                               Icon="BootstrapIcon.Award"
                                               OnClick="async () => await HandleSendCertificateClick(row.Partner)" />

                            <HxContextMenuItem Text="Test connection"
                                               Icon="BootstrapIcon.Plug"
                                               OnClick="async () => await HandleTestConnectionClick(row.Partner)" />

                            <HxContextMenuItem Text="Send test file"
                                               Icon="BootstrapIcon.Send"
                                               OnClick="async () => await HandleSendTestFileClick(row.Partner, null)" />

                            <HxContextMenuItem Text="Delete"
                                               Icon="BootstrapIcon.Trash"
                                               OnClick="async () => await HandleDeleteClick(row.Partner)"
                                               ConfirmationQuestion="@($"Are you sure you really want to delete selected partners? ({row.Partner.Id})")"/>
                        }
                    </HxContextMenu>
                </HxContextMenuGridColumn>
            </Columns>
        </HxGrid>
    </DataTemplate>
 
</HxListLayout>
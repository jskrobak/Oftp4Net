@page "/ReceivedFiles"
@rendermode InteractiveServer
@using Havit.Collections
@using Oftp4Net.DataLayer.Filters
@using Oftp4Net.Domain
@using Oftp4Net.Core.Protocol
<style>
    .scrollable-table-container {
        overflow: auto;
        height: calc(100vh - 160px);
    }
</style>

<HxModal @ref="notDeliveredModal" ShowCloseButton="true">
    <HeaderTemplate>
        Report as not delivered
    </HeaderTemplate>
    <BodyTemplate>
        @if (notDeliveredFile is not null)
        {
            <p>
                A Negative End Response (NERP) is sent to @notDeliveredFile.Partner?.Name in the next session
                instead of the positive one, so the partner learns that
                <strong>@notDeliveredFile.VirtualFileName</strong> did not reach its destination.
            </p>

            <HxSelect TItem="KeyValuePair<string, string>"
                      TValue="string"
                      Label="Reason"
                      Data="NerpReasons"
                      @bind-Value="notDeliveredReasonCode"
                      TextSelector="@(r => $"{r.Key} - {r.Value}")"
                      ValueSelector="@(r => r.Key)"
                      Nullable="false" />

            <HxInputTextArea Label="Description" Hint="Sent to the partner in the response (NERPREAST)."
                             @bind-Value="notDeliveredReasonText" />

            <HxButton Color="ThemeColor.Warning" Icon="BootstrapIcon.ExclamationTriangle"
                      OnClick="ReportNotDelivered" CssClass="mt-3">
                Report as not delivered
            </HxButton>
        }
    </BodyTemplate>
</HxModal>

<HxListLayout Title="Received files" TFilterModel="ReceivedFileFilter"
              @bind-FilterModel="filterModel"
              @bind-FilterModel:after="gridComponent.RefreshDataAsync">
    <CommandsTemplate>
        <HxButton Text="Refresh"
                  Color="ThemeColor.Secondary"
                  Icon="BootstrapIcon.ArrowClockwise" OnClick="() => gridComponent.RefreshDataAsync()" />
    </CommandsTemplate>
    <FilterTemplate Context="filterContext">
        <HxInputText Label="Virtual file name" @bind-Value="filterContext.Name" />
    </FilterTemplate>
    <DataTemplate>
        <HxGrid @ref="gridComponent"
                ContentNavigationMode="GridContentNavigationMode.Pagination"
                PageSize="1000"
                TableContainerCssClass="scrollable-table-container"
                HeaderRowCssClass="sticky-top"
                TItem="ReceivedFile"
                DataProvider="GetGridData"
                Responsive="true">
            <Columns>
                <HxGridColumn HeaderText="Received"
                              ItemTextSelector="@(d => d.Created.ToString("g"))"
                              SortKeySelector="d => d.Created"
                              IsDefaultSortColumn="true"
                              SortDirection="SortDirection.Descending"/>
                <HxGridColumn HeaderText="VFN"
                              ItemTextSelector="@(d => d.VirtualFileName)"
                              SortKeySelector="d => d.VirtualFileName"/>
                <HxGridColumn HeaderText="Partner"
                              ItemTextSelector="@(d => d.Partner?.Name)"/>
                <HxGridColumn HeaderText="Originator"
                              ItemTextSelector="@(d => d.Originator)"/>
                <HxGridColumn HeaderText="Destination"
                              ItemTextSelector="@(d => d.Destination)"/>
                <HxGridColumn HeaderText="Size"
                              ItemTextSelector="@(d => d.Size.ToString("N0"))"
                              SortKeySelector="d => d.Size"
                              ItemCssClass="text-end"
                              HeaderCssClass="text-end"/>
                <HxGridColumn HeaderText="Status"
                              SortKeySelector="d => d.Status">
                    <ItemTemplate Context="file">
                        <HxBadge Color="@GetStatusColor(file.Status)">@file.Status</HxBadge>
                        @if (!string.IsNullOrEmpty(file.LastError))
                        {
                            <span class="ms-2 text-danger">@file.LastError</span>
                        }
                    </ItemTemplate>
                </HxGridColumn>
                <HxGridColumn HeaderText="">
                    <ItemTemplate Context="file">
                        @if (file.Status is ReceiveStatus.RECEIVED or ReceiveStatus.CONFIRMED or ReceiveStatus.NOT_DELIVERED
                                 or ReceiveStatus.HELD)
                        {
                            <a href="@($"received/{file.Id}/download")" target="_blank" title="Download">
                                <HxIcon Icon="BootstrapIcon.Download"/>
                            </a>
                        }
                        @if (file is { Status: ReceiveStatus.RECEIVED, ConfirmedDate: null })
                        {
                            <a href="javascript:void(0)" class="ms-2" title="Report as not delivered"
                               @onclick="() => ShowNotDelivered(file)">
                                <HxIcon Icon="BootstrapIcon.ExclamationTriangle"/>
                            </a>
                        }
                    </ItemTemplate>
                </HxGridColumn>
            </Columns>
        </HxGrid>
    </DataTemplate>
</HxListLayout>

@using Oftp4Net.Domain
@using Oftp4Net.Services.Security

@* Sends one of our certificates to Partner (Odette OP08 2.5, automatic exchange of certificates). *@
<div class="row g-2">
    <div class="col-md-6">
        <label class="form-label">Identity</label>
        <select class="form-select" value="@identityId" @onchange="e => identityId = int.Parse((string)e.Value!)">
            @foreach (var identity in Identities)
            {
                <option value="@identity.Id">@identity.Name (@identity.SFID)</option>
            }
        </select>
    </div>
    <div class="col-md-6">
        <label class="form-label">Exchange</label>
        <select class="form-select" value="@kind" @onchange="e => kind = Enum.Parse<CertificateExchangeKind>((string)e.Value!)">
            <option value="@CertificateExchangeKind.Deliver">ODETTE_CERTIFICATE_DELIVER - a new certificate, the old one stays valid</option>
            <option value="@CertificateExchangeKind.Replace">ODETTE_CERTIFICATE_REPLACE - the old certificate must not be used any more</option>
            <option value="@CertificateExchangeKind.Request">ODETTE_CERTIFICATE_REQUEST - our certificate, asking for the partner's one</option>
        </select>
    </div>
    <div class="col-md-6">
        <label class="form-label">Certificate to send</label>
        <select class="form-select" value="@certificateId" @onchange="e => certificateId = int.Parse((string)e.Value!)">
            @foreach (var certificate in Certificates)
            {
                <option value="@certificate.Id">@certificate.Name (valid to @certificate.ValidTo.ToString("d"))</option>
            }
        </select>
        <div class="form-text">Only the certificate is sent, never the private key.</div>
    </div>
    <div class="col-md-6">
        <label class="form-label">Replaces (SFIDDESC)</label>
        <select class="form-select" value="@replacedId" @onchange="e => replacedId = string.IsNullOrEmpty((string?)e.Value) ? null : int.Parse((string)e.Value!)">
            <option value="">none - the partner assigns it itself</option>
            @foreach (var certificate in Certificates.Where(c => c.Id != certificateId))
            {
                <option value="@certificate.Id">@certificate.Name</option>
            }
        </select>
        <div class="form-text">Our certificate the partner has so far; its identification data lets the partner assign the new one.</div>
    </div>
    @if (Partner.SubStations.Count > 0)
    {
        <div class="col-md-6">
            <label class="form-label">Destination</label>
            <select class="form-select" value="@destinationSfid" @onchange="e => destinationSfid = (string?)e.Value">
                <option value="">@Partner.SFID (the partner itself)</option>
                @foreach (var station in Partner.SubStations)
                {
                    <option value="@station.SFID">@station.SFID (@station.Name)</option>
                }
            </select>
        </div>
    }
</div>

@if (Certificates.Count == 0)
{
    <HxAlert Color="ThemeColor.Warning" CssClass="py-2 mt-3">There is no certificate with a private key; add one in Certificates first.</HxAlert>
}
else
{
    <div class="mt-3">
        <HxButton Color="ThemeColor.Primary" Icon="BootstrapIcon.Send" Spinner="sending" OnClick="SendAsync">Send to @Partner.Name</HxButton>
        <div class="form-text">
            Sent as virtual file @CertificateExchange.FileName(kind) in DER, unsecured (SFIDSEC 00, SFIDSIGN N), as the
            specification requires. The partner confirms it with an EERP, or reports with a NERP what it could not do with it.
        </div>
    </div>
}

@code {
    // Its own scope (database context): the page around it works with the context of the circuit at the same time.
    [Inject] protected IServiceScopeFactory ScopeFactory { get; set; } = null!;
    [Inject] protected Oftp4Net.Services.SendService SendService { get; set; } = null!;
    [Inject] protected IHxMessengerService Messenger { get; set; } = null!;

    [Parameter, EditorRequired] public Partner Partner { get; set; } = null!;

    [Parameter, EditorRequired] public IReadOnlyList<Identity> Identities { get; set; } = [];

    /// <summary>Our certificates, i.e. the ones with a private key.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<Certificate> Certificates { get; set; } = [];

    /// <summary>The certificate preselected, usually the one configured for file security.</summary>
    [Parameter] public int? CertificateId { get; set; }

    [Parameter] public EventCallback OnSent { get; set; }

    private int identityId;
    private int certificateId;
    private int? replacedId;
    private string? destinationSfid;
    private CertificateExchangeKind kind = CertificateExchangeKind.Deliver;
    private bool sending;

    protected override void OnParametersSet()
    {
        if (identityId == 0)
            identityId = Identities.FirstOrDefault()?.Id ?? 0;
        if (certificateId == 0)
            certificateId = CertificateId ?? Certificates.FirstOrDefault()?.Id ?? 0;
    }

    private async Task SendAsync()
    {
        sending = true;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var exchange = scope.ServiceProvider.GetRequiredService<CertificateExchangeService>();
            await exchange.QueueAsync(Partner, identityId, kind, certificateId, replacedId,
                string.IsNullOrEmpty(destinationSfid) ? null : destinationSfid);

            SendService.Trigger();
            Messenger.AddInformation($"{CertificateExchange.FileName(kind)} queued for {Partner.Name}.");
            await OnSent.InvokeAsync();
        }
        catch (Exception ex)
        {
            Messenger.AddError($"The certificate cannot be sent: {ex.Message}");
        }
        finally
        {
            sending = false;
        }
    }
}

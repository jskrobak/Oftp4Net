@page "/ConnectionTests"
@rendermode InteractiveServer
@using Oftp4Net.Domain
@using Oftp4Net.Services.ConnectionTests
@using Oftp4Net.Core.Transport

<HxCard>
    <HeaderTemplate>
        <h5 class="card-title me-auto">Connection tests</h5>
    </HeaderTemplate>
    <BodyTemplate>
        <p class="small text-body-secondary" style="max-width: 60rem;">
            A test opens the session as for sending: TCP, TLS with the certificates of both sides, SSID with codes and
            passwords and the secure authentication. Then it ends the session before the direction changes, so neither
            side offers a file or an End to End Response, and the send queue is not touched. The partners are tested one
            after another; a partner with a session of ours running is skipped. Every test is in the transfer log.
            Click a partner to change it, or the shield of a refused certificate to settle it; the test runs again when
            the change is saved.
        </p>

        <div class="d-flex flex-wrap gap-2 align-items-end mb-3">
            <div style="min-width: 22rem;">
                @if (identities is not null)
                {
                    <HxSelect TItem="Identity" TValue="int" Label="Test as identity"
                              Data="identities" @bind-Value="identityId"
                              TextSelector="@(i => $"{i.Name} ({i.SSID})")" ValueSelector="@(i => i.Id)" Nullable="false" />
                }
            </div>
            <HxButton Color="ThemeColor.Primary" Icon="BootstrapIcon.PlayFill" Enabled="CanStart"
                      OnClick="() => Start(partners)">Test all</HxButton>
            <HxButton Color="ThemeColor.Secondary" Icon="BootstrapIcon.ArrowRepeat" Enabled="CanStart && Failed.Count > 0"
                      OnClick="() => Start(Failed)">Test failed again (@Failed.Count)</HxButton>
            @if (Tests.IsRunning)
            {
                <HxButton Color="ThemeColor.Secondary" Icon="BootstrapIcon.StopFill" OnClick="Tests.Cancel">Stop</HxButton>
                <span class="small text-body-secondary align-self-center">
                    <HxSpinner Size="SpinnerSize.Small" Color="ThemeColor.Secondary" /> @Tests.Progress.Done of @Tests.Progress.Total
                </span>
            }
        </div>

        @if (Tests.Results.Count > 0)
        {
            <div class="small mb-2">
                <HxBadge Color="ThemeColor.Success">@Tests.Results.Values.Count(r => r.Success) succeeded</HxBadge>
                <HxBadge Color="ThemeColor.Danger">@Failed.Count failed</HxBadge>
                <HxBadge Color="ThemeColor.Secondary">@(partners.Count - Tests.Results.Count) not tested</HxBadge>
            </div>
        }

        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>Partner</th>
                        <th>Address</th>
                        <th>Result</th>
                        <th>Details</th>
                        <th>Tested</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var partner in partners)
                    {
                        var result = Tests.Results.GetValueOrDefault(partner.Id);
                        <tr>
                            <td>
                                <button type="button" class="btn btn-link p-0 fw-bold text-start" title="Edit the partner"
                                        @onclick="() => EditPartnerAsync(partner)">@partner.Name</button>
                                <div class="small text-body-secondary">@partner.SSID</div>
                            </td>
                            <td class="small">
                                @partner.Host:@partner.Port
                                @if (partner.UseTls)
                                {
                                    <HxBadge Color="ThemeColor.Light" TextColor="ThemeColor.Dark" CssClass="ms-1">TLS</HxBadge>
                                }
                            </td>
                            <td>
                                @if (Tests.Current == partner.Id)
                                {
                                    <HxSpinner Size="SpinnerSize.Small" Color="ThemeColor.Secondary" />
                                }
                                else if (result is not null)
                                {
                                    <HxBadge Color="@StageColor(result)">@StageText(result)</HxBadge>
                                }
                            </td>
                            <td class="small" style="max-width: 36rem;">
                                @if (result is not null)
                                {
                                    <div class="@(result.Success ? "text-body-secondary" : "")">@result.Message</div>
                                    @if (result.Negotiated is not null)
                                    {
                                        <div class="text-body-secondary">@result.Negotiated</div>
                                    }
                                    @if (result.Tls is not null)
                                    {
                                        <div class="text-body-secondary">@result.Tls</div>
                                    }
                                    @if (result.RemoteCertificate is not null)
                                    {
                                        <div class="text-body-secondary text-break">@result.RemoteCertificate</div>
                                    }
                                }
                            </td>
                            <td class="small text-nowrap">
                                @if (result is not null)
                                {
                                    <div>@result.Tested.ToString("g")</div>
                                    <div class="text-body-secondary">@result.Duration.TotalSeconds.ToString("F1") s as @result.Identity</div>
                                }
                            </td>
                            <td class="text-nowrap">
                                <HxButton Size="ButtonSize.Small" Color="ThemeColor.Secondary" Icon="BootstrapIcon.PlayFill"
                                          Tooltip="Test this partner" Enabled="CanStart" OnClick="() => Start([partner])" />
                                <HxButton Size="ButtonSize.Small" Color="ThemeColor.Secondary" Icon="BootstrapIcon.Send"
                                          Tooltip="Send a test file to this partner" OnClick="() => SendTestFileAsync(partner)" />
                                @if (result is { RemoteCertificateData: not null, CertificateProblem: not null })
                                {
                                    <HxButton Size="ButtonSize.Small" Color="ThemeColor.Warning" Icon="BootstrapIcon.ShieldExclamation"
                                              Tooltip="The partner's TLS certificate: call the name it is issued for, trust it or accept it"
                                              Enabled="!Tests.IsRunning" OnClick="() => ShowCertificateAsync(partner, result)" />
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </BodyTemplate>
</HxCard>

<HxModal @ref="testFileModal" ShowCloseButton="true" Size="ModalSize.Large">
    <HeaderTemplate>Send a test file to @testFilePartner?.Name</HeaderTemplate>
    <BodyTemplate>
        @if (testFilePartner is not null && identities is not null)
        {
            <TestFileForm Partner="testFilePartner" Identities="identities" />
        }
    </BodyTemplate>
</HxModal>

<HxModal @ref="partnerEditModal" ShowCloseButton="true" Size="ModalSize.Large" Scrollable="true">
    <HeaderTemplate>Partner @editedPartner?.Name</HeaderTemplate>
    <BodyTemplate>
        @if (editedPartner is not null)
        {
            <PartnerForm Partner="editedPartner" Certificates="certificates" Identities="identities ?? []"
                         OnSaved="HandlePartnerSavedAsync" />
        }
    </BodyTemplate>
</HxModal>

<HxModal @ref="certificateModal" Title="@($"TLS certificate of {certificatePartner?.Name}")" ShowCloseButton="true" Size="ModalSize.Large">
    <BodyTemplate>
        @if (presented is { } certificate && certificatePartner is { } partner)
        {
            <HxAlert Color="ThemeColor.Danger" CssClass="small">@presented.Problem</HxAlert>
            <dl class="row small mb-3">
                <dt class="col-sm-3">Called</dt>
                <dd class="col-sm-9">@partner.Host:@partner.Port</dd>
                <dt class="col-sm-3">Issued for</dt>
                <dd class="col-sm-9 text-break">
                    @(certificate.Names.Count > 0 ? string.Join(", ", certificate.Names) : "-")
                    @if (presented.Problem == OftpCertificateProblems.NameMismatch)
                    {
                        <div class="text-body-secondary">
                            When a certificate lists names of its own (subject alternative names), only those count; the
                            common name (CN) of its subject is not used then.
                        </div>
                    }
                </dd>
                <dt class="col-sm-3">Odette ID</dt>
                <dd class="col-sm-9 text-break">
                    @(certificate.OdetteIds.Count > 0 ? string.Join(", ", certificate.OdetteIds) : "-")
                    @if (certificate.OdetteIds.Count > 0 && presented.Problem == OftpCertificateProblems.NameMismatch &&
                         !certificate.OdetteIds.Contains(partner.SSID.Trim(), StringComparer.OrdinalIgnoreCase))
                    {
                        <div class="text-body-secondary">
                            The SSID of @partner.Name is @partner.SSID. A certificate carrying the SSID would be accepted by it
                            (<em>Settings</em> → <em>Accept a partner's certificate by its Odette ID</em>).
                        </div>
                    }
                </dd>
                <dt class="col-sm-3">Subject</dt>
                <dd class="col-sm-9 text-break">@certificate.Subject</dd>
                <dt class="col-sm-3">Issued by</dt>
                <dd class="col-sm-9 text-break">@certificate.Issuer</dd>
                <dt class="col-sm-3">Valid</dt>
                <dd class="col-sm-9 @(certificate.IsValidNow ? "" : "text-danger")">@certificate.ValidFrom.ToString("d") – @certificate.ValidTo.ToString("d")</dd>
                <dt class="col-sm-3">SHA-256</dt>
                <dd class="col-sm-9 text-break"><code>@certificate.Sha256Fingerprint</code></dd>
                <dt class="col-sm-3">Trusted now</dt>
                <dd class="col-sm-9 text-break">@TrustedText(partner)</dd>
            </dl>

            @if (OtherNames.Count > 0)
            {
                <h6>Call the name the certificate is issued for</h6>
                <p class="small text-body-secondary">
                    The certificate is issued for another name than the partner's host. Calling that name keeps all checks
                    of the certificate; the name has to lead to the same server.
                </p>
                <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
                    @foreach (var name in OtherNames)
                    {
                        @if (resolvingNames.Contains(name))
                        {
                            <HxButton Color="ThemeColor.Primary" Icon="BootstrapIcon.ArrowRepeat" Enabled="!saving"
                                      OnClick="() => UseHostAsync(name)">Call @name</HxButton>
                        }
                        else
                        {
                            <span class="small text-body-secondary"><code>@name</code> does not resolve here, so it cannot be called.</span>
                        }
                    }
                </div>
            }

            <h6>Trust this certificate</h6>
            <p class="small text-body-secondary">
                The certificate becomes the trusted certificate of @partner.Name and is accepted by itself, whatever
                address was called and whoever issued it, as long as it is valid. When the partner replaces it, the new one
                has to be trusted again. Accepting an invalid certificate is turned off. Compare the SHA-256 fingerprint with
                the one the partner gives you.
            </p>
            <HxButton Color="@(resolvingNames.Count > 0 ? ThemeColor.Secondary : ThemeColor.Primary)" Icon="BootstrapIcon.ShieldCheck" CssClass="mb-3"
                      Enabled="@(!saving && certificate.IsValidNow)" OnClick="TrustAsync">Trust this certificate</HxButton>

            <h6>Accept an invalid certificate</h6>
            <p class="small text-body-secondary">
                @partner.Name is called although its certificate is not valid, as OS4X did. The connection stays encrypted,
                but TLS no longer proves who answers; connection tests still report the problem.
            </p>
            <HxButton Color="ThemeColor.Danger" Outline="true" Icon="BootstrapIcon.ShieldSlash"
                      Enabled="@(!saving && !partner.AcceptInvalidTlsCertificate)" OnClick="AcceptInvalidAsync">Accept an invalid certificate</HxButton>
        }
    </BodyTemplate>
</HxModal>

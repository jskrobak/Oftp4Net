<!DOCTYPE html>
<html lang="cs">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="icon" type="image/svg+xml" href="logo.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="icon-192.png" />
    <link rel="apple-touch-icon" href="apple-touch-icon.png" />
    <script>
        // Applies the stored colour mode before the page is rendered, so it does not flash in the wrong theme.
        (function () {
            const match = document.cookie.match(/(?:^|;\s*)oftp4net-color-mode=([^;]*)/);
            const mode = match ? decodeURIComponent(match[1]).toLowerCase() : 'auto';
            const dark = mode === 'dark' || mode === '2'
                || ((mode === 'auto' || mode === '0') && window.matchMedia('(prefers-color-scheme: dark)').matches);
            document.documentElement.setAttribute('data-bs-theme', dark ? 'dark' : 'light');
        })();
    </script>
    @* Bootstrap first, the styles of the application after it: they set its colours to the ones of the logo. *@
    @((MarkupString)HxSetup.RenderBootstrapCssReference(BootstrapFlavor.PlainBootstrap))
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Oftp4Net.Server.styles.css"]" />
    <HeadOutlet @rendermode="PageRenderMode"/>
</head>

<body>
<Routes @rendermode="PageRenderMode"/>
<script>process = undefined;</script>
<script src="_framework/blazor.web.js"></script>
@((MarkupString)@HxSetup.RenderBootstrapJavaScriptReference())
</body>

</html>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = null!;

    // The login page is rendered statically so that it can set the authentication cookie.
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}

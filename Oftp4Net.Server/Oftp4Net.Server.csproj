<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <!-- Secrets of the development machine (dotnet user-secrets), stored in the profile of the user. -->
        <UserSecretsId>41c6d51c-08ff-401b-a7c6-7055144197ec</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
      <Content Include="..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <!-- The Zabbix template is downloaded from Settings / Monitoring, so it is part of the application. -->
      <EmbeddedResource Include="..\samples\zabbix\oftp4net_by_http.yaml" LogicalName="$(MSBuildProjectName).oftp4net_by_http.yaml" Link="Monitoring\oftp4net_by_http.yaml" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="BitzArt.Blazor.Cookies.Server" />
      <PackageReference Include="Havit.Blazor.Components.Web.Bootstrap" />
      <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
      <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
      <PackageReference Include="Scalar.AspNetCore" />
      <PackageReference Include="Serilog" />
      <PackageReference Include="Serilog.Extensions.Logging" />
      <PackageReference Include="Serilog.Sinks.File" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Oftp4Net.Core\Oftp4Net.Core.csproj" />
      <ProjectReference Include="..\Oftp4Net.DependencyInjection\Oftp4Net.DependencyInjection.csproj" />
    </ItemGroup>

</Project>
